  "fixed_sql": [
    {
      "name": "user_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" TEXT NOT NULL, \"preferred_styles\" TEXT NOT NULL DEFAULT '[]', \"favored_colors\" TEXT NOT NULL DEFAULT '[]', \"avoided_colors\" TEXT NOT NULL DEFAULT '[]', \"fit_preference\" TEXT NULL, \"formality_preference\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clothing_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_items\" (\"id\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"subcategory\" TEXT NULL, \"display_name\" TEXT NULL, \"notes\" TEXT NULL, \"primary_color\" TEXT NULL, \"pattern\" TEXT NULL, \"formality\" INTEGER NULL CHECK(\"formality\" IS NULL OR \"formality\" BETWEEN 1 AND 5), \"fit\" TEXT NULL, \"brand\" TEXT NULL, \"warmth\" INTEGER NULL CHECK(\"warmth\" IS NULL OR \"warmth\" BETWEEN 1 AND 3), \"status\" TEXT NOT NULL, \"show_cutout\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_cutout\" IN (0, 1)), \"content_sha256\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clothing_item_colors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_item_colors\" (\"item_id\" TEXT NOT NULL REFERENCES clothing_items (id) ON DELETE CASCADE, \"color\" TEXT NOT NULL, \"role\" TEXT NOT NULL, PRIMARY KEY (\"item_id\", \"color\", \"role\"));"
        }
      ]
    },
    {
      "name": "clothing_item_seasons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_item_seasons\" (\"item_id\" TEXT NOT NULL REFERENCES clothing_items (id) ON DELETE CASCADE, \"season\" TEXT NOT NULL, PRIMARY KEY (\"item_id\", \"season\"));"
        }
      ]
    },
    {
      "name": "clothing_images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_images\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES clothing_items (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"byte_size\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clothing_attributes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clothing_attributes\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES clothing_items (id) ON DELETE CASCADE, \"attribute\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"confidence\" REAL NULL CHECK(\"confidence\" IS NULL OR \"confidence\" BETWEEN 0.0 AND 1.0), \"model_id\" TEXT NULL, \"model_version\" TEXT NULL, \"analyzed_at\" INTEGER NULL, \"user_confirmed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"user_confirmed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outfits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outfits\" (\"id\" TEXT NOT NULL, \"signature\" TEXT NOT NULL, \"occasion\" TEXT NOT NULL, \"request_json\" TEXT NOT NULL, \"total_score\" REAL NOT NULL, \"breakdown_json\" TEXT NOT NULL, \"reasons_json\" TEXT NOT NULL, \"weather_considered\" INTEGER NOT NULL CHECK (\"weather_considered\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outfit_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outfit_items\" (\"outfit_id\" TEXT NOT NULL REFERENCES outfits (id) ON DELETE CASCADE, \"item_id\" TEXT NOT NULL REFERENCES clothing_items (id) ON DELETE RESTRICT, \"slot\" TEXT NOT NULL, PRIMARY KEY (\"outfit_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "outfit_feedback",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outfit_feedback\" (\"id\" TEXT NOT NULL, \"outfit_id\" TEXT NOT NULL REFERENCES outfits (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"reason_code\" TEXT NULL, \"reason_text\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "learned_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"learned_preferences\" (\"key\" TEXT NOT NULL, \"weight\" REAL NOT NULL CHECK(\"weight\" BETWEEN -0.3 AND 0.3), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
